{
	"manifest_version": 3,
	"name": "PR Pulse - GitHub Pull Request Dashboard",
	"version": "1.2.0",
	"description": "PR Pulse is a Pull Request dashboard for GitHub, delivered as a Chrome extension. Say No to Navigation!",
	"permissions": [
		"storage",
		"alarms"
	],
	"host_permissions": [
		"https://api.github.com/*"
	],
	"action": {
		"default_popup": "popup/popup.html",
		"default_icon": {
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"background": {
		"service_worker": "service-worker.js",
		"type": "module"
	},
	"options_page": "settings/settings.html",
	"icons": {
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}