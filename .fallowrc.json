{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": [
		"extension/service-worker.ts",
		"extension/src/popup/main.ts",
		"extension/src/onboarding/main.ts",
		"extension/src/settings/main.ts",
		"vite.config.ts",
		"website/src/main.ts",
		"website/vite.config.ts",
		"website/svelte.config.js",
		"scripts/generate-manifest.ts",
		"scripts/generate-og.ts",
		"scripts/prerender.ts",
		"scripts/find-unused-css.ts"
	],
	"ignorePatterns": ["node_modules/**", "**/dist/**", "build/**", "**/*.d.ts", "**/.cache/**", "**/.ssr-tmp/**"],
	"ignoreExportsUsedInFile": true,
	"duplicates": {
		"minOccurrences": 2
	},
	"health": {
		"maxCyclomatic": 30,
		"maxCognitive": 20,
		"maxCrap": 150
	},
	"rules": {
		"unlisted-dependencies": "off"
	}
}
